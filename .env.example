# ─────────────────────────────────────────────────────────────
# CRM RedRex — variáveis de ambiente (copie para .env e preencha)
# Validadas por lib/env.ts (falha cedo). Segredos NUNCA em NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────

# Públicas (client) — Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor — Supabase service role (contorna RLS; só em rotas de servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Servidor — Calendly (polling, plano Free). Token só no servidor.
CALENDLY_TOKEN=
CALENDLY_USER_URI=
CALENDLY_EVENT_TYPE_URI=

# Servidor — IA (Anthropic Messages, claude-sonnet-4-6). Limite de gasto na conta.
ANTHROPIC_API_KEY=

# Servidor — tl;dv (verificação HMAC do webhook)
TLDV_WEBHOOK_SECRET=

# Servidor — proteção das rotas de cron (Vercel Cron)
CRON_SECRET=

# Servidor — Gmail (rascunho de follow-up; opcional no MVP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
