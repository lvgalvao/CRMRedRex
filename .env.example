# ─────────────────────────────────────────────────────────────
# CRM RedRex — variáveis de ambiente (copie para .env e preencha)
# Validadas por lib/env.ts (falha cedo). Segredos NUNCA em NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────

# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (contorna RLS; só no servidor, via lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# É só isto. As integrações estão desativadas (segundo momento)
# e suas variáveis foram removidas daqui de propósito — elas
# voltam junto com o código que as consome.
#
# As rotas estão fora do roteamento do Next (private folders `_`):
#   app/api/_webhooks/{tldv,calendly}/route.ts
#   app/api/_sync/calendly/route.ts
#   app/api/_jobs/no-show/route.ts
#
# Para religar:
#   1. renomeie as pastas removendo o `_`
#   2. recoloque <SyncButton /> em app/(crm)/{pipeline,visao-geral}/page.tsx
#   3. devolva os crons ao vercel.json
#   4. adicione as variáveis (nomes exatos em lib/env.ts):
#        CALENDLY_TOKEN  <- não CALENDLY_API_TOKEN
#        CALENDLY_USER_URI, CALENDLY_EVENT_TYPE_URI
#        ANTHROPIC_API_KEY, TLDV_WEBHOOK_SECRET
#        CRON_SECRET (openssl rand -hex 32)
#        GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN
#
# ARMADILHA ao religar: o middleware protege TODAS as rotas
# (lib/supabase/middleware.ts:38) e redireciona /api/* para /login,
# então webhooks e cron nunca chegam a validar HMAC nem CRON_SECRET.
# É preciso isentar /api/_webhooks e /api/_sync antes de testar.
#
# Os playbooks NÃO dependem de IA: fillTemplate substitui as
# {{variaveis}} de forma determinística (lib/services/fillTemplate.ts).
# ─────────────────────────────────────────────────────────────
